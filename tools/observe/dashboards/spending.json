          "refId": "B",
          "expr": "sum(increase(step_tokens_cache_write_total{service_name=\"$service\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\"}[$__range]))",
          "legendFormat": "cache writes",
          "instant": true,
          "range": false
