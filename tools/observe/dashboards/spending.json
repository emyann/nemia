          "refId": "D",
          "expr": "sum(increase(step_tokens_output_total{service_name=\"$service\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\"}[$__range]))",
          "legendFormat": "output",
