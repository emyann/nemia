{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A try's `then` ('round', 'nudge', 'fresh') is a string on run records and api answers, never callable, so `await`
    // cannot take it for a promise; renaming it would move a word on every record on disk for no bug.
    "unicorn/no-thenable": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": ["test", "it", "describe", "suite"], "package": "node:test" }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
