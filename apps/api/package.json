{
  "name": "api",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages/agent-orchestrator/src --watch-path=../../packages/agent-orchestrator/place/git --watch-path=../../packages/agent-runtime/src src/main.ts --no-tick",
    "start": "node src/main.ts",
    "test": "node --import=../../tools/test-costs/probe.ts --import ./test/harness.ts --test --test-concurrency=2 --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../tools/test-costs/reporter.ts --test-reporter-destination=stderr 'test/*.test.ts' 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agent-orchestrator": "*",
    "effect": "4.0.6",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "agent-runtime": "*",
    "typescript": "^6.0.3"
  }
}
