{
  "name": "nemia",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emyann/nemia.git"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/guards"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "nemia": {
    "daemon": "apps/api/src/main.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && oxfmt --check",
    "contracts": "tsverify packages/agent-runtime/src --cache && tsverify packages/agent-orchestrator/src --project packages/agent-orchestrator/contracts/tsconfig.json --cache",
    "format": "oxfmt",
    "e2e": "npm run e2e --workspace web --",
    "board:serve": "npm run board:serve --workspace web",
    "board:stop": "npm run board:stop --workspace web",
    "release:check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@emyann/tsverify": "^0.2.0",
    "@playwright/mcp": "0.0.80",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "js-yaml": "^4.3.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "1.64.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
