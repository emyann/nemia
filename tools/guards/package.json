{
  "name": "guards",
  "version": "1.0.0",
  "private": true,
  "description": "The repository's own guards: tests that hold its CI configuration, docs and workflows. Never shipped.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --import=../../tools/test-costs/probe.ts --test --test-concurrency=2 --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../tools/test-costs/reporter.ts --test-reporter-destination=stderr 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agent-orchestrator": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
