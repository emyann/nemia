    {
      "id": 7,
      "type": "bargauge",
      "title": "Where its time went",
      "description": "Every run of the chosen steps over the range, from Tempo's span metrics: the model, each tool, Bash by its command head, and Other, the turns less these.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(traces_spanmetrics_latency_sum{service=\"claude-code\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\", span_name=\"claude_code.llm_request\"}[$__range]))",
          "legendFormat": "model",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (tool_name) (increase(traces_spanmetrics_latency_sum{service=\"claude-code\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\", span_name=\"claude_code.tool\", tool_name!=\"Bash\"}[$__range]))",
          "legendFormat": "{{tool_name}}",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "label_replace(sum by (command_head) (increase(traces_spanmetrics_latency_sum{service=\"claude-code\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\", span_name=\"claude_code.tool\", tool_name=\"Bash\"}[$__range])), \"command_head\", \"(no command)\", \"command_head\", \"\")",
          "legendFormat": "Bash: {{command_head}}",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "O",
          "expr": "clamp_min(sum(increase(traces_spanmetrics_latency_sum{service=\"claude-code\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\", span_name=\"claude_code.interaction\"}[$__range])) - sum(increase(traces_spanmetrics_latency_sum{service=\"claude-code\", factory=~\"$factory\", workflow=~\"$workflow\", step=~\"$step\", agent=~\"$agent\", span_name=~\"claude_code.llm_request|claude_code.tool\"}[$__range])), 0)",
          "legendFormat": "Other",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "continuous-BlPu"
