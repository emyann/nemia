{
  "uid": "nemia-spending",
  "title": "Spending",
  "description": "What the factory spends: its tokens by kind, what each agent spends per task, and the subscription's quota over the week.",
  "tags": [
    "nemia"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nemia"
      ],
      "asDropdown": false,
      "title": "Nemia",
      "includeVars": false,
      "keepTime": true
    }
