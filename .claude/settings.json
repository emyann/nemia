{
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "mcp__playwright__browser_run_code_unsafe"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npx turbo run test:*)",
      "Bash(node --test:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git merge-tree:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(cd:*)",
      "WebSearch",
      "WebFetch",
      "Bash(npx shadcn@latest:*)"
    ]
  }
}
