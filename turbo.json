{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"]
    },
    "agent-orchestrator#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/test/**",
        "$TURBO_ROOT$/apps/*/*.ts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/workflows/agents/**",
        "$TURBO_ROOT$/packages/agent-runtime/**",
        "!$TURBO_ROOT$/packages/agent-runtime/.turbo/**"
      ]
    },
    "agent-runtime#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/test/**",
        "$TURBO_ROOT$/apps/*/*.ts",
        "$TURBO_ROOT$/packages/agent-orchestrator/src/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/bin/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/test/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/place/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
