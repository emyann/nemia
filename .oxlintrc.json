{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "jsPlugins": [{ "name": "comments", "specifier": "./lint/comments.ts" }],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A try's `then` ('round', 'nudge', 'fresh') is a string on run records and api answers, never callable, so `await`
    // cannot take it for a promise; renaming it would move a word on every record on disk for no bug.
    "unicorn/no-thenable": "off",
    // A name that starts with `_` says it is unused on purpose: a callback's leading argument, a destructured field left out.
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": ["test", "it", "describe", "suite"], "package": "node:test" }
        ]
      }
    ],
    // A bare sort of strings is in code-unit order, which is what a test comparing two lists as sets wants; one of numbers or tuples is not.
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    // An ARIA role is the right tool where the tag the rule names is the wrong element: a drawn status dot is no `<img>`, and a live
    // message is no form's `<output>`.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The React Compiler's own rules: a memo it cannot keep, a state copied in an effect, a render that reads the clock.
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "error",
    "react/purity": "error",
    // From the suspicious category, the rules that find a bug or needless code rather than a style.
    "preserve-caught-error": "error",
    // Not typescript/consistent-return: a declared return type already makes tsc require a value on every path, and the rule misreads
    // what tsc understands (an exhaustive switch, `assert.fail`, an effect that returns its cleanup only when it set something up).
    "no-unmodified-loop-condition": "error",
    // Not typescript/no-unnecessary-type-conversion: a draft the board sends is typed as its current shape, and a page opened before a
    // change sends what it had, as a driver may report a state that is none; String() there is the guard the type cannot state. On in the
    // files that decode what they read (the first override).
    "typescript/no-unnecessary-template-expression": "error",
    // Not typescript/no-unnecessary-boolean-literal-compare: `x !== true` is how a guard refuses a caller that does not keep the type
    // (`holdOpen: 'yes'`), and its fix to `!x` let that caller through; the refusal's own test caught it. On in the files that decode
    // what they read (the first override).
    "typescript/no-unnecessary-type-arguments": "error",
    // An `as T` or a `!` that tells tsc what it already knows is noise that hides the casts that matter.
    "typescript/no-unnecessary-type-assertion": "error",
    "unicorn/no-array-fill-with-reference-type": "error"
  },
  "overrides": [
    {
      // The two rules left off above, on where what comes from outside is decoded by a schema before it is typed (Effect Schema: a
      // journal, a detached run file, a run record and a person's asks, daemon.json and tick stats, a queue try, the api's request
      // bodies): there a value's type is what the value is, so a `String()` or a `=== true` the type makes needless guards nothing. A
      // value such a file still takes by a cast keeps its guard with an `oxlint-disable-next-line` saying why.
      "files": [
        "packages/agent-runtime/src/event-schema.ts",
        "packages/agent-runtime/src/journal.ts",
        "packages/agent-runtime/src/runner-detached.ts",
        "packages/agent-orchestrator/src/store.ts",
        "packages/agent-orchestrator/src/daemon-store.ts",
        "packages/agent-orchestrator/src/inbox-store.ts",
        "apps/api/src/body.ts",
        "apps/api/src/agents.ts",
        "apps/api/src/asks.ts",
        "apps/api/src/builder.ts",
        "apps/api/src/inbox.ts",
        "apps/api/src/runs.ts",
        "apps/api/src/skills.ts",
        "apps/api/src/workflows.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error"
      }
    },
    {
      // What a test prints is read by the developer who runs it, from raw harness JSON and fetch mocks; the messages a person reads are
      // made in src, where a value that could be an object is never stringified as `[object Object]`.
      "files": ["**/test/**"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    // The comment guards (lint/comments.ts, CLAUDE.md "Code reads by itself"), one block per package, the same rules in each. A block
    // whose `excludeFiles` names its own package is off: the card that cleans a package switches it on by deleting that one line, and
    // edits nothing shared. The runtime's block also covers lint/**, the guards' own plugin. packages/agent-orchestrator/test/comments.test.ts
    // reads these blocks.
    {
      "files": ["apps/api/**"],
      "excludeFiles": ["apps/api/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-orchestrator/**"],
      "excludeFiles": ["packages/agent-orchestrator/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-runtime/**", "lint/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
