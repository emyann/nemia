{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  // The design system kit is another repository's code (french-tech-homies/design-system): the shadcn CLI writes it into the board from
  // the `@ds` registry, its skills beside it, and an update fetches it again and is read as a diff. Nothing here shapes it, so no rule
  // reads it. packages/agent-orchestrator/test/comments.test.ts holds this list and refuses a folder that joins it.
  "ignorePatterns": ["apps/web/src/components/ui/ds/**", "apps/web/.claude/**"],
  "jsPlugins": [
    { "name": "comments", "specifier": "./lint/comments.ts" },
    { "name": "sonarjs", "specifier": "eslint-plugin-sonarjs" }
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A try's `then` ('round', 'nudge', 'fresh') is a string on run records and api answers, never callable, so `await`
    // cannot take it for a promise; renaming it would move a word on every record on disk for no bug.
    "unicorn/no-thenable": "off",
    // A name that starts with `_` says it is unused on purpose: a callback's leading argument, a destructured field left out.
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": ["test", "it", "describe", "suite"], "package": "node:test" }
        ]
      }
    ],
    // A bare sort of strings is in code-unit order, which is what a test comparing two lists as sets wants; one of numbers or tuples is not.
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    // An ARIA role is the right tool where the tag the rule names is the wrong element: a drawn status dot is no `<img>`, and a live
    // message is no form's `<output>`.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The React Compiler's own rules: a memo it cannot keep, a state copied in an effect, a render that reads the clock.
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "error",
    "react/purity": "error",
    // From the suspicious category, the rules that find a bug or needless code rather than a style.
    "preserve-caught-error": "error",
    // Not typescript/consistent-return: a declared return type already makes tsc require a value on every path, and the rule misreads
    // what tsc understands (an exhaustive switch, `assert.fail`, an effect that returns its cleanup only when it set something up).
    "no-unmodified-loop-condition": "error",
    // Not typescript/no-unnecessary-type-conversion: a draft the board sends is typed as its current shape, and a page opened before a
    // change sends what it had, as a driver may report a state that is none; String() there is the guard the type cannot state. On in the
    // files that decode what they read (the first override).
    "typescript/no-unnecessary-template-expression": "error",
    // Not typescript/no-unnecessary-boolean-literal-compare: `x !== true` is how a guard refuses a caller that does not keep the type
    // (`holdOpen: 'yes'`), and its fix to `!x` let that caller through; the refusal's own test caught it. On in the files that decode
    // what they read (the first override).
    "typescript/no-unnecessary-type-arguments": "error",
    // An `as T` or a `!` that tells tsc what it already knows is noise that hides the casts that matter.
    "typescript/no-unnecessary-type-assertion": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    // The size and complexity limits (docs/design-2026-09-28-feature-folders.md, "The limits"). The sizes skip blank lines and comments,
    // so a JSDoc is never a reason to split. A file over one today has its own ceiling in an override below, and never a higher one.
    "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": true, "skipComments": true }],
    // Cyclomatic counts the paths, so it says how many tests a function needs; cognitive weighs the nesting, which cyclomatic does not.
    "complexity": ["error", { "max": 20 }],
    "sonarjs/cognitive-complexity": ["error", 15]
  },
  "overrides": [
    {
      // The two rules left off above, on where what comes from outside is decoded by a schema before it is typed (Effect Schema: a
      // journal, a detached run file and what was read of its output, a Codex `exec --json` stream, a Claude Code transcript line, a run record and a person's asks, daemon.json and tick stats, a
      // queue try, a line of the feed, the api's request bodies, the board's reads of the api): there a value's type is what the value is, so a `String()` or a `=== true` the type makes needless guards nothing. A
      // value such a file still takes by a cast keeps its guard with an `oxlint-disable-next-line` saying why.
      "files": [
        "packages/agent-runtime/src/core/event-schema.ts",
        "packages/agent-runtime/src/core/engine/journal.ts",
        "packages/agent-runtime/src/harness/detached/detached.ts",
        "packages/agent-runtime/src/harness/detached/run-file.ts",
        "packages/agent-runtime/src/harness/detached/said.ts",
        "packages/agent-runtime/src/harness/codex/stream.ts",
        "packages/agent-runtime/src/harness/claude/lines.ts",
        "packages/agent-orchestrator/src/record/record.store.ts",
        "packages/agent-orchestrator/src/daemon/daemon.store.ts",
        "packages/agent-orchestrator/src/inbox/inbox.store.ts",
        "packages/agent-orchestrator/src/feed/feed.store.ts",
        "apps/api/src/body.ts",
        "apps/api/src/agents/agents.ts",
        "apps/api/src/commands/routes.ts",
        "apps/api/src/commands/extend.ts",
        "apps/api/src/workflows/builder.ts",
        "apps/api/src/inbox/inbox.ts",
        "apps/api/src/runs/runs.ts",
        "apps/api/src/agents/skills.ts",
        "apps/api/src/workflows/workflows.ts",
        "apps/web/src/lib/api/read.ts",
        "apps/web/src/lib/api/judged.ts",
        "apps/web/src/lib/api/graph.ts",
        "apps/web/src/lib/api/runs.ts",
        "apps/web/src/lib/api/detail.ts",
        "apps/web/src/lib/api/decision.ts",
        "apps/web/src/lib/api/steps.ts",
        "apps/web/src/lib/api/tries.ts",
        "apps/web/src/lib/api/usage.ts",
        "apps/web/src/lib/api/library.ts",
        "apps/web/src/lib/api/agents.ts",
        "apps/web/src/lib/api/skills.ts",
        "apps/web/src/lib/api/workflows.ts",
        "apps/web/src/lib/api/builder.ts",
        "apps/web/src/lib/api/machines.ts",
        "apps/web/src/lib/api/inbox.ts",
        "apps/web/src/lib/api/capabilities.ts",
        "apps/web/src/lib/api/quota.ts",
        "apps/web/src/lib/api/ceilings.ts",
        "apps/web/src/lib/api/daemon.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error"
      }
    },
    {
      // What a test prints is read by the developer who runs it, from raw harness JSON and fetch mocks; the messages a person reads are
      // made in src, where a value that could be an object is never stringified as `[object Object]`. A test beside its code is one too.
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    // The comment guards (lint/comments.ts, CLAUDE.md "Code reads by itself"), one block per package, the same rules in each, none with
    // an `excludeFiles`. The runtime's block also covers the folders beside the packages: lint/**, the guards' own plugin, and tools/**,
    // the repository's test tooling.
    // packages/agent-orchestrator/test/comments.test.ts reads these blocks.
    {
      "files": ["apps/api/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/docs/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-orchestrator/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-runtime/**", "lint/**", "tools/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    // The layers (docs/architecture.md): each reaches the one below it, and nothing reaches up or skips one. One block per layer, over its
    // source alone, since a test may import the runtime's entries for a fake. Their globs never overlap, because a later block that sets
    // `no-restricted-imports` on a file replaces an earlier one's options. packages/agent-orchestrator/test/imports.boundary.test.ts reads these blocks.
    // The board reaches the api over HTTP alone: no workspace package, no harness SDK, no path into packages/.
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator", "agent-orchestrator/**", "agent-runtime", "agent-runtime/**"],
                "message": "The board reaches the api over HTTP alone: ask the api for what this import gives"
              },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: ask the api for what this import gives"
              },
              { "group": ["**/packages/**"], "message": "The board imports no package's file: ask the api for what this import gives" }
            ]
          }
        ]
      }
    },
    // The api reaches the orchestrator's public entries alone, and never the runtime or a harness.
    {
      "files": ["apps/api/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator/**", "!agent-orchestrator/run", "!agent-orchestrator/workflow"],
                "message": "The api reaches agent-orchestrator through its entries alone: agent-orchestrator, /run or /workflow"
              },
              {
                "group": ["agent-runtime", "agent-runtime/**"],
                "message": "The api never reaches the runtime: call the orchestrator entry that does"
              },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: call the orchestrator entry that does"
              },
              { "group": ["**/packages/**"], "message": "The api imports a package by its name and entries, never a path into it" }
            ]
          }
        ]
      }
    },
    // The orchestrator reaches the runtime through its client, and a harness never.
    {
      "files": ["packages/agent-orchestrator/src/**", "packages/agent-orchestrator/bin/**", "packages/agent-orchestrator/place/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: reach it through src/runtime-client.ts"
              }
            ]
          }
        ]
      }
    },
    // The runtime is the bottom layer: it reaches no layer above it.
    {
      "files": ["packages/agent-runtime/src/**", "packages/agent-runtime/bin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator", "agent-orchestrator/**", "**/agent-orchestrator/**"],
                "message": "The runtime reaches no layer above it: carry the knob on the task, read by a runner"
              }
            ]
          }
        ]
      }
    },
    // The size and complexity limits are off where a file is not code a person shapes. A test file is a list of cases, and its length is
    // its coverage.
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off",
        "sonarjs/cognitive-complexity": "off"
      }
    },
    // The shadcn components are written by the shadcn CLI, through apps/web/components.json, and pinned by skills-lock.json.
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off",
        "sonarjs/cognitive-complexity": "off"
      }
    },
    // The route tree is generated by TanStack Router's plugin on every build.
    {
      "files": ["apps/web/src/routeTree.gen.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off",
        "sonarjs/cognitive-complexity": "off"
      }
    },
