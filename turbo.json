{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"]
    },
    "agent-orchestrator#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/test/**",
        "$TURBO_ROOT$/apps/*/*.ts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/CLAUDE.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/workflows/agents/**",
        "$TURBO_ROOT$/packages/agent-runtime/**",
        "!$TURBO_ROOT$/packages/agent-runtime/.turbo/**"
      ]
    },
    "guards#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/workflows/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/package-lock.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/agent-runtime/test/remote-agent.test.ts",
        "$TURBO_ROOT$/apps/web/test/e2e/pages/NAMES",
        "$TURBO_ROOT$/apps/web/src/routeTree.gen.ts",
        "$TURBO_ROOT$/apps/web/theme/**"
      ]
    },
    "agent-runtime#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/test/**",
        "$TURBO_ROOT$/apps/*/*.ts",
        "$TURBO_ROOT$/packages/agent-orchestrator/src/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/bin/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/test/**",
        "$TURBO_ROOT$/packages/agent-orchestrator/place/**"
      ]
    },
    "api#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/place/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "web#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/.claude/skills/change-the-board/SKILL.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/.gitattributes"
      ]
    },
    "docs#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/test/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/workflows/**",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/CLAUDE.md"
      ]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/README.md", "$TURBO_ROOT$/packages/*/docs/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
