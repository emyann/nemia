{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--output-dir",
        "${WF_STEP_FILES:-/tmp/playwright-mcp}"
      ]
    }
  }
}
