{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Interfere's rules for tests that cannot lie (@interfere/landmines, pinned exactly at the root), every one on as shipped but where
  // a rule below or an override sets it, each with its reason, so that none refuses what a rule of ours asks for.
  "extends": ["./node_modules/@interfere/landmines/configs/recommended.json"],
  "options": {
    "typeAware": true
  },
  // The code that is not ours, as .gitattributes marks it: the design system kit the shadcn CLI writes into the board from the `@ds`
  // registry and its skills beside it (another project's, vendored unchanged), the route tree TanStack Router's plugin writes, and the
  // worker `npx msw init` writes for the board's Storybook.
  // Nothing here shapes them, so no rule reads them. tools/guards/test/comments.test.ts holds this list to .gitattributes: a file of
  // code marked there that no glob here skips is refused, and so is a glob that skips a file of ours.
  "ignorePatterns": [
    "apps/web/src/components/ui/ds/**",
    "apps/web/.claude/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/.storybook/public/**"
  ],
  "jsPlugins": [
    { "name": "comments", "specifier": "./lint/comments.ts" },
    { "name": "sonarjs", "specifier": "eslint-plugin-sonarjs" }
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // A try's `cause` ('round', 'continue', 'fresh') is a string on run records and api answers, never callable, so `await`
    // cannot take it for a promise; renaming it would move a word on every record on disk for no bug.
    "unicorn/no-thenable": "off",
    // A name that starts with `_` says it is unused on purpose: a callback's leading argument, a destructured field left out.
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": ["test", "it", "describe"], "package": "vitest" }
        ]
      }
    ],
    // A bare sort of strings is in code-unit order, which is what a test comparing two lists as sets wants; one of numbers or tuples is not.
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    // An ARIA role is the right tool where the tag the rule names is the wrong element: a drawn status dot is no `<img>`, and a live
    // message is no form's `<output>`.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The React Compiler's own rules: a memo it cannot keep, a state copied in an effect, a render that reads the clock.
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "error",
    "react/purity": "error",
    // From the suspicious category, the rules that find a bug or needless code rather than a style.
    "preserve-caught-error": "error",
    // Not typescript/consistent-return: a declared return type already makes tsc require a value on every path, and the rule misreads
    // what tsc understands (an exhaustive switch, `assert.fail`, an effect that returns its cleanup only when it set something up).
    "no-unmodified-loop-condition": "error",
    // Not typescript/no-unnecessary-type-conversion: a draft the board sends is typed as its current shape, and a page opened before a
    // change sends what it had, as a driver may report a state that is none; String() there is the guard the type cannot state. On in the
    // files that decode what they read (the first override).
    "typescript/no-unnecessary-template-expression": "error",
    // Not typescript/no-unnecessary-boolean-literal-compare: `x !== true` is how a guard refuses a caller that does not keep the type
    // (`holdOpen: 'yes'`), and its fix to `!x` let that caller through; the refusal's own test caught it. On in the files that decode
    // what they read (the first override).
    "typescript/no-unnecessary-type-arguments": "error",
    // An `as T` or a `!` that tells tsc what it already knows is noise that hides the casts that matter.
    "typescript/no-unnecessary-type-assertion": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    // The size and complexity limits. The sizes skip blank lines and comments, so a JSDoc is never a reason to split. max-lines is a stop
    // at 800 code lines for every file, with no ceiling for any one (docs/architecture.md, "Folders, in every package"): a file that
    // reaches it is cut along its concepts, and no file under it is split for its size. A file over a function limit today has its own
    // ceiling in an override below, and never a higher one (docs/design-2026-09-28-feature-folders.md, "The limits").
    // tools/guards/test/limits.test.ts reads these thresholds and the per-file ceilings from here, refuses a ceiling on max-lines, and
    // refuses a disable that names a limit.
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": true, "skipComments": true }],
    // Cyclomatic counts the paths, so it says how many tests a function needs; cognitive weighs the nesting, which cyclomatic does not.
    "complexity": ["error", { "max": 20 }],
    "sonarjs/cognitive-complexity": ["error", 15],
    // Off: what a thing is for is said where its reader finds it, a file's header or a private declaration's doc, and our own
    // comments plugin (lint/comments.ts) keeps refusing a comment inside a body.
    "landmines-style/no-comments": "off",
    // Off in source, on in tests (an override below): whether source's return types are inferred is a decision of its own card.
    "landmines-types/no-explicit-return-types": "off",
    // Each file that waits on a fixed delay today, by its count: the rule refuses a file whose count differs, so one mended is
    // cut here (a key for a file gone is not reported). A new sleep waits on what it waits for instead.
    "landmines-testing/no-fixed-sleep": [
      "error",
      {
        "allow": {
          "apps/api/src/gauges/feed.test.ts": 1,
          "apps/api/test/harness.test.ts": 1,
          "apps/api/test/main.test.ts": 1,
          "apps/web/test/api.test.ts": 1,
          "apps/web/test/e2e-serve-token.boundary.test.ts": 1,
          "apps/web/test/read-pages.test.ts": 2,
          "packages/agent-orchestrator/test/store.test.ts": 1,
          "packages/agent-runtime/test/detached.test.ts": 2,
          "packages/agent-runtime/test/engine-verbs.test.ts": 4,
          "packages/agent-runtime/test/waits.test.ts": 4
        }
      }
    ],
    // Each retry or raised timeout today, by its count, a vitest.config.ts's testTimeout and hookTimeout among them (120 s, the
    // repository's ceiling for a test and a hook): the list only shrinks, as no-fixed-sleep's does.
    "landmines-testing/no-flake-masking": [
      "error",
      {
        "allow": {
          "apps/api/src/steps/following.test.ts": 2,
          "apps/api/src/steps/transcript.test.ts": 1,
          "apps/api/vitest.config.ts": 2,
          "apps/cli/test/ambient.test.ts": 1,
          "apps/cli/test/channel.test.ts": 1,
          "apps/cli/test/watch.test.ts": 1,
          "apps/cli/vitest.config.ts": 2,
          "apps/docs/vitest.config.ts": 2,
          "apps/web/test/e2e/visit.test.ts": 14,
          "apps/web/vitest.config.ts": 4,
          "packages/agent-orchestrator/test/mcp-config.test.ts": 2,
          "packages/agent-orchestrator/test/step-labels.boundary.test.ts": 1,
          "packages/agent-orchestrator/vitest.config.ts": 2,
          "packages/agent-runtime/test/fixtures/waits/never.ts": 1,
          "packages/agent-runtime/test/live-sdk.boundary.test.ts": 3,
          "packages/agent-runtime/test/live.test.ts": 16,
          "packages/agent-runtime/test/remote-agent.test.ts": 1,
          "packages/agent-runtime/vitest.config.ts": 2,
          "packages/objects/vitest.config.ts": 2,
          "packages/templates/vitest.config.ts": 2,
          "tools/guards/vitest.config.ts": 2,
          "tools/test-kit/vitest.config.ts": 2
        }
      }
    ]
  },
  "overrides": [
    {
      // The two rules left off above, on where what comes from outside is decoded by a schema before it is typed (Effect Schema: a
      // journal, a detached run file and what was read of its output, a Codex `exec --json` stream, a Claude Code transcript line, a run record and a person's asks, daemon.json and tick stats, a
      // queue try, a line of the feed, the api's request bodies, the board's reads of the api): there a value's type is what the value is, so a `String()` or a `=== true` the type makes needless guards nothing. A
      // value such a file still takes by a cast keeps its guard with an `oxlint-disable-next-line` saying why.
      "files": [
        "packages/agent-runtime/src/core/event-schema.ts",
        "packages/agent-runtime/src/core/engine/journal.ts",
        "packages/agent-runtime/src/harness/detached/detached.ts",
        "packages/agent-runtime/src/harness/detached/run-file.ts",
        "packages/agent-runtime/src/harness/detached/said.ts",
        "packages/agent-runtime/src/harness/codex/stream.ts",
        "packages/agent-runtime/src/harness/claude/lines.ts",
        "packages/agent-orchestrator/src/record/record.store.ts",
        "packages/agent-orchestrator/src/daemon/daemon.store.ts",
        "packages/agent-orchestrator/src/inbox/inbox.store.ts",
        "packages/agent-orchestrator/src/feed/feed.store.ts",
        "apps/api/src/agents/agents.ts",
        "apps/api/src/runs/start.ts",
        "apps/api/src/workflows/builder.ts",
        "apps/api/src/inbox/inbox.ts",
        "apps/api/src/skills/skills.ts",
        "apps/api/src/workflows/workflows.ts",
        "apps/web/src/lib/api/read.ts",
        "apps/web/src/lib/api/judged.ts",
        "apps/web/src/lib/api/graph.ts",
        "apps/web/src/lib/api/runs.ts",
        "apps/web/src/lib/api/detail.ts",
        "apps/web/src/lib/api/decision.ts",
        "apps/web/src/lib/api/steps.ts",
        "apps/web/src/lib/api/tries.ts",
        "apps/web/src/lib/api/usage.ts",
        "apps/web/src/lib/api/library.ts",
        "apps/web/src/lib/api/agents.ts",
        "apps/web/src/lib/api/skills.ts",
        "apps/web/src/lib/api/workflows.ts",
        "apps/web/src/lib/api/builder.ts",
        "apps/web/src/lib/api/inbox.ts",
        "apps/web/src/lib/api/capabilities.ts",
        "apps/web/src/lib/api/quota.ts",
        "apps/web/src/lib/api/ceilings.ts",
        "apps/web/src/lib/api/daemon.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error"
      }
    },
    {
      // What a test prints is read by the developer who runs it, from raw harness JSON and fetch mocks; the messages a person reads are
      // made in src, where a value that could be an object is never stringified as `[object Object]`. A test beside its code is one too.
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    // The comment guards (lint/comments.ts), one block per package, the same rules in each, none with an `excludeFiles`. The runtime's
    // block also covers the folders beside the packages: lint/**, the guards' own plugin, and tools/**, the repository's test tooling.
    // tools/guards/test/comments.test.ts holds this file's shape for them.
    {
      "files": ["apps/api/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/cli/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/docs/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-orchestrator/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/objects/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/templates/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    {
      "files": ["packages/agent-runtime/**", "lint/**", "tools/**"],
      "rules": {
        "comments/no-code-comments": "error",
        "comments/no-history-in-comments": "error",
        "comments/no-deferral-in-comments": "error",
        "comments/no-wide-comment-lines": "error",
        "no-warning-comments": [
          "error",
          { "terms": ["todo", "fixme", "xxx", "hack", "workaround", "work around", "stopgap", "learned by"], "location": "anywhere" }
        ],
        "no-inline-comments": ["error", { "ignorePattern": "^\\s*(oxlint|eslint)-(disable|enable)" }]
      }
    },
    // The layers (docs/architecture.md): each reaches the one below it, and nothing reaches up or skips one. One block per layer, over its
    // source alone, since a test may import the runtime's entries for a fake. Their globs never overlap, because a later block that sets
    // `no-restricted-imports` on a file replaces an earlier one's options.
    // packages/agent-orchestrator/test/imports.boundary.test.ts holds them to the layers of docs/architecture.md.
    // The board reaches the api over HTTP alone: no workspace package but the objects' entry, `objects`, no harness SDK, no path into
    // packages/.
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator", "agent-orchestrator/**", "agent-runtime", "agent-runtime/**"],
                "message": "The board reaches the api over HTTP alone: ask the api for what this import gives"
              },
              { "group": ["objects/**"], "message": "The board imports the objects by their entry alone: import it from 'objects'" },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: ask the api for what this import gives"
              },
              { "group": ["**/packages/**"], "message": "The board imports no package's file: ask the api for what this import gives" }
            ]
          }
        ]
      }
    },
    // The client reaches the api over HTTP alone, and its answers' shapes by their types: no workspace package but the objects' entry,
    // `objects`, no harness SDK, no path into packages/, and from the api nothing but `import type` of its client door, apps/api/src/client/client.ts. The value pattern comes first
    // and the door's after it, since oxlint lets through, for every pattern after it, an import a negated group matches. Its one reach of
    // the orchestrator is a resolve of agent-orchestrator/bin in src/local.ts, which is no import: the orchestrator's contract.test.ts
    // holds it, and apps/cli/test/structure.test.ts the rest. A test beside its source is of no layer.
    {
      "files": ["apps/cli/src/**", "apps/cli/bin/**"],
      "excludeFiles": ["apps/cli/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:api|(?:\\.\\.?/)+api)(?:/|$)",
                "allowTypeImports": true,
                "message": "The client imports the api's types alone: import type it from apps/api/src/client/client.ts, and ask the api over HTTP"
              },
              {
                "group": ["agent-orchestrator", "agent-orchestrator/**", "agent-runtime", "agent-runtime/**"],
                "message": "The client reaches the api over HTTP alone: ask the api, or spawn the orchestrator's CLI from src/local.ts"
              },
              { "group": ["objects/**"], "message": "The client imports the objects by their entry alone: import it from 'objects'" },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: ask the api for what this import gives"
              },
              { "group": ["**/packages/**"], "message": "The client imports no package's file: ask the api for what this import gives" },
              {
                "group": ["api", "api/**", "**/api/**", "!api/src/client/client.ts", "!**/api/src/client/client.ts"],
                "message": "The client reads the api's types from its client door alone: import type them from apps/api/src/client/client.ts"
              }
            ]
          }
        ]
      }
    },
    // The api reaches the orchestrator's public entries alone, the objects by their entry, and never the runtime or a harness. A test beside its source is of no layer,
    // as one under apps/api/test is: it takes the stand-ins by the two testing entries.
    {
      "files": ["apps/api/src/**"],
      "excludeFiles": ["apps/api/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator/**", "!agent-orchestrator/run", "!agent-orchestrator/workflow"],
                "message": "The api reaches agent-orchestrator through its entries alone: agent-orchestrator, /run or /workflow"
              },
              { "group": ["objects/**"], "message": "The api imports the objects by their entry alone: import it from 'objects'" },
              {
                "group": ["agent-runtime", "agent-runtime/**"],
                "message": "The api never reaches the runtime: call the orchestrator entry that does"
              },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: call the orchestrator entry that does"
              },
              { "group": ["**/packages/**"], "message": "The api imports a package by its name and entries, never a path into it" }
            ]
          }
        ]
      }
    },
    // The orchestrator reaches the runtime through its client, the objects by their entry, and a harness never.
    {
      "files": ["packages/agent-orchestrator/src/**", "packages/agent-orchestrator/bin/**", "packages/agent-orchestrator/place/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["objects/**"],
                "message": "The orchestrator imports the objects by their entry alone: import it from 'objects'"
              },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk/**", "@a2a-js/sdk", "@a2a-js/sdk/**"],
                "message": "Only agent-runtime reaches a harness: reach it through src/runtime-client.ts"
              }
            ]
          }
        ]
      }
    },
    // The runtime's source is under noUncheckedIndexedAccess, which makes every index read say what its absence means; `x!` would take
    // that back, so it is refused there. A test's `!` is a loud claim that the value is there, and a failing test already answers it.
    // packages/agent-orchestrator/test/index-reads.test.ts holds this block and the flag.
    {
      "files": ["packages/agent-runtime/src/**", "packages/agent-runtime/bin/**"],
      "excludeFiles": ["packages/agent-runtime/src/**/*.test.ts"],
      "rules": { "typescript/no-non-null-assertion": "error" }
    },
    // The orchestrator's source and the api's are under the same flag, and refuse `x!` for the same reason; their tests are not.
    // packages/agent-orchestrator/test/index-reads.test.ts holds these blocks and the flag.
    {
      "files": [
        "packages/agent-orchestrator/src/**",
        "packages/agent-orchestrator/bin/**",
        "packages/agent-orchestrator/place/**"
      ],
      "excludeFiles": ["packages/agent-orchestrator/src/**/*.test.ts", "packages/agent-orchestrator/place/**/*.test.ts"],
      "rules": { "typescript/no-non-null-assertion": "error" }
    },
    {
      "files": ["apps/api/src/**", "apps/api/bin/**"],
      "excludeFiles": ["apps/api/src/**/*.test.ts"],
      "rules": { "typescript/no-non-null-assertion": "error" }
    },
    {
      "files": ["apps/cli/src/**", "apps/cli/bin/**"],
      "excludeFiles": ["apps/cli/src/**/*.test.ts"],
      "rules": { "typescript/no-non-null-assertion": "error" }
    },
    // The runtime is the bottom layer: it reaches no layer above it, nor the objects beside it, which are the layers above's words.
    {
      "files": ["packages/agent-runtime/src/**", "packages/agent-runtime/bin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["agent-orchestrator", "agent-orchestrator/**", "**/agent-orchestrator/**"],
                "message": "The runtime reaches no layer above it: carry the knob on the task, read by a runner"
              },
              {
                "group": ["objects", "objects/**", "**/objects/**"],
                "message": "The runtime never reads an object of the layers above: carry what a session needs on the task, read by a runner"
              }
            ]
          }
        ]
      }
    },
    // The objects sit at the bottom beside the runtime, and every layer above reads them, the board in a browser: they import `effect`
    // and their own files alone (`./x.ts`), no other package, no node built-in and no path out of src but a contract's type
    // (`../contracts/<name>.contract.ts`, imported by `import type`, which no build keeps). One group refuses every import and lets those
    // through by negation: oxlint's regex reads no lookahead, and refuses nothing with one. packages/objects/CLAUDE.md.
    {
      "files": ["packages/objects/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!effect", "!effect/**", "!./**", "!../contracts/*.contract.ts"],
                "message": "The objects import effect and their own files alone: write it with effect's Schema, in a file of packages/objects/src"
              }
            ]
          }
        ]
      }
    },
    // The size and complexity limits are off where a file is not code a person shapes. A test file is a list of cases, and its length is
    // its coverage.
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off",
        "sonarjs/cognitive-complexity": "off"
      }
    },
    // A test's return types are inferred; landmines' rule, off in source above, holds them here.
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "landmines-types/no-explicit-return-types": "error"
      }
    },
    // A workspace's own test/ folder holds its tests, beside the tests kept next to their code (root CLAUDE.md, Check your work);
    // the rule takes a test's owner from the source folder it imports and accepts only that folder or a test/ inside it.
    {
      "files": ["packages/*/test/**", "apps/*/test/**", "tools/*/test/**"],
      "rules": {
        "landmines-structure/colocated-tests": "off"
      }
    },
    // Three api tests drive their own folder's routes through the app over HTTP, and import from src/objects one constant or helper
    // of the serving, which the rule takes for their owner: they stay beside the routes they test.
    {
      "files": ["apps/api/src/files/files.test.ts", "apps/api/src/runs/actions.test.ts", "apps/api/src/factory/templated.test.ts"],
      "rules": {
        "landmines-structure/colocated-tests": "off"
      }
    },
    // apps/api/src/mcp/tools.ts is no test: the rule takes the file's own function named `describe` for a suite's, and its last
    // argument for a suite's options.
    {
      "files": ["apps/api/src/mcp/tools.ts"],
      "rules": {
        "landmines-testing/no-flake-masking": "off"
      }
    },
    // apps/web/test/waits.ts and apps/docs/test/waits.ts are the runtime's src/waits/waits.ts byte for byte (neither imports a package;
    // waits.test.ts holds the copies): their return types are source's, which keeps them.
    {
      "files": ["apps/web/test/waits.ts", "apps/docs/test/waits.ts"],
      "rules": {
        "landmines-types/no-explicit-return-types": "off"
      }
    },
    // The route tree is generated by TanStack Router's plugin on every build.
    {
      // JSON read at a boundary (a file, a process's output, a stream, a request body) is decoded by a schema, never parsed by hand and
      // cast: `Schema.fromJsonString(S)`, or `Schema.UnknownFromJsonString` where a caller words "not JSON" apart from a wrong field.
      // The files that keep `JSON.parse` turn it off in the blocks after this one, each with its reason.
      "files": ["packages/*/src/**", "apps/*/src/**"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "JSON",
            "property": "parse",
            "message": "Decode JSON read at a boundary with Schema.fromJsonString(S) (Schema.UnknownFromJsonString where the value decodes after): a file that must keep JSON.parse is a kept block of .oxlintrc.json, with why"
          }
        ]
      }
    },
    {
      // Kept: a refusal that quotes the parser's own words, its position among them, which Schema.fromJsonString drops. The file parses with
      // JSON.parse alone and decodes the value through its schema; a person fixing a hand-edited file needs the position.
      "files": [
        "packages/agent-orchestrator/src/record/record.store.ts",
        "packages/agent-orchestrator/src/skills/read.store.ts",
        "packages/agent-orchestrator/src/harness/a2a.store.ts",
        "packages/agent-orchestrator/src/factory/applied/applied.store.ts",
        "packages/agent-orchestrator/src/factory/factory.store.ts",
