{
  "name": "nemia",
  "version": "1.27.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emyann/nemia.git"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/guards",
    "tools/test-kit"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "nemia": {
    "daemon": "apps/api/src/main.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && oxfmt --check",
    "lint:fast": "oxlint -c .oxlintrc.fast.json && oxfmt --check",
    "rules": "node tools/guards/rules.ts",
    "api": "node apps/api/src/openapi/overview.ts",
    "api:page": "node apps/api/bin/page.ts",
    "contracts": "node tools/contracts/prove.ts",
    "format": "oxfmt",
    "e2e": "npm run e2e --workspace web --",
    "board:serve": "npm run board:serve --workspace web",
    "board:stop": "npm run board:stop --workspace web",
    "storybook": "npm run storybook --workspace web",
    "release:check": "npm run typecheck && npm test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@emyann/tsverify": "0.9.1",
    "@playwright/mcp": "0.0.80",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "js-yaml": "^4.3.2",
    "lint-staged": "17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "1.64.1",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": "oxlint -c .oxlintrc.fast.json"
  }
}
