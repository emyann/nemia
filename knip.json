{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/coverage/{record,compare}.ts",
        "tools/release/{release,archive}.ts",
        "tools/store-measure/{report,loop}.ts",
        "tools/observe/profile/preload.ts",
        "tools/observe/render/{render,reap,hold}.ts"
      ]
    },
    "packages/agent-runtime": {
      "entry": [
        "bin/*.ts",
        "test/fixtures/**/*.ts"
      ]
    },
    "packages/agent-orchestrator": {
      "entry": [
        "bin/*.ts",
        "test/fixtures/**/*.ts",
        "test/exporting-child.ts"
      ]
    },
    "packages/templates": {
      "entry": [
        "released.ts",
        "*/carried/*.ts",
        "*/workflows/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/openapi/print.ts",
        "bin/*.ts",
        "test/fixtures/**/*.ts"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/content.config.mjs",
        "test/dev.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "test/e2e/worker.ts",
        "test/e2e/pages/*.ts",
        "test/e2e/stories/*.ts",
        "test/e2e/broken-page.ts",
        "test/e2e/contrast-report.ts",
        "test/e2e/look-photos.ts",
        "src/components/look/index.ts"
      ],
      "ignoreDependencies": [
        "@google/design.md"
      ]
    },
    "tools/guards": {
      "entry": [
        "test/fixtures/**/*.ts"
      ]
    },
    "tools/design-system": {
      "entry": [
        "src/cards/runner.ts"
      ],
      "ignoreDependencies": [
        "lucide-react",
        "tailwindcss"
      ]
    }
  },
  "ignore": [
    "apps/web/.claude/**",
    "apps/web/.storybook/public/**"
  ],
  "ignoreIssues": {
    "**/contracts/*.contract.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/components/ui/ds/**": [
      "files",
      "exports",
      "types",
      "duplicates"
    ],
    "packages/objects/src/{delegation,proposal,schedule,trigger,words}.ts": [
      "duplicates"
    ]
  },
  "ignoreBinaries": [
    "codex",
    "systemd-run",
    "nemia"
  ]
}
