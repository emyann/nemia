{
  "name": "nemia",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "nemia": {
    "daemon": "apps/api/src/main.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "e2e": "npm run e2e --workspace web --",
    "board:serve": "npm run board:serve --workspace web",
    "board:stop": "npm run board:stop --workspace web",
    "release:check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.80",
    "@types/node": "^22.20.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
