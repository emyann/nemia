{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/e2e",
    "test": "node --import=../../tools/test-costs/probe.ts --test --test-concurrency=2 --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../tools/test-costs/reporter.ts --test-reporter-destination=stderr test/*.test.ts",
    "e2e": "node --test --test-timeout=120000 test/e2e/*.test.ts && node test/e2e/run.ts",
    "board:serve": "node test/e2e/serve.ts serve",
    "board:stop": "node test/e2e/serve.ts stop",
    "storybook": "storybook dev -p 6007 --no-open"
  },
