{
  "uid": "nemia-timeline",
  "title": "Timeline",
  "description": "A workflow's timeline, averaged over its runs that ended in the range: each step's sessions, their time queued and at work with its check under it, its tries and what a session cost, each round's wall time, and the run's wall time beside its waits.",
  "tags": [
    "nemia"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "nemia",
        "current": {
          "text": "nemia",
          "value": "nemia"
        },
        "options": [
          {
            "text": "nemia",
            "value": "nemia",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "The service the daemon files under: OTEL_SERVICE_NAME, else nemia."
      },
      {
        "name": "factory",
        "label": "Factory",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(step_tries_total{service_name=\"$service\"}, factory)",
        "definition": "label_values(step_tries_total{service_name=\"$service\"}, factory)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0,
        "description": "One factory: two factories' workflows of one name would be averaged together."
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(step_tries_total{service_name=\"$service\", factory=\"$factory\"}, workflow)",
        "definition": "label_values(step_tries_total{service_name=\"$service\", factory=\"$factory\"}, workflow)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0,
        "description": "One workflow: two workflows' rows would be averaged together."
      },
      {
        "name": "outcome",
        "label": "Runs that",
        "type": "custom",
        "query": "succeeded,cancelled",
        "current": {
          "text": "succeeded",
          "value": "succeeded"
        },
        "options": [
          {
            "text": "succeeded",
            "value": "succeeded",
            "selected": true
          },
          {
            "text": "cancelled",
            "value": "cancelled",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "description": "How the runs counted ended: succeeded, or called off."
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nemia"
      ],
      "asDropdown": false,
      "title": "Nemia",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Ran, mean",
      "description": "How long a step's session ran, and under each step how long its check ran: the mean over every session of every run counted. A try that answered an earlier try's session is a turn of that session, and in its time.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && name=\"run.timeline\" && span.factory=\"$factory\" && span.workflow=\"$workflow\" && span.outcome=~\"$outcome\" && span.of=~\"try|check\" && span.part=\"ran\"} | avg_over_time(span.value) by (span.row)",
          "metricsQueryType": "instant",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          },
          "noValue": "no run ended in the range"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 22,
        "text": {
          "titleSize": 12,
          "valueSize": 14
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(?:\\{span\\.row=\"(.*)\"\\}|(.*))$",
            "renamePattern": "$1$2"
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false,
            "labelsToFields": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Field",
                "desc": false
